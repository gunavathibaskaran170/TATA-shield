{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SHIELD Telemetry Contract v1.0",
  "type": "object",
  "required": [
    "schema_version",
    "vehicle_id",
    "device_id",
    "session_id",
    "run_id",
    "source",
    "sequence",
    "device_monotonic_ms",
    "received_at",
    "geometry_version",
    "calibration_version",
    "configuration_revision",
    "measurements"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "vehicle_id": { "type": "string" },
    "device_id": { "type": "string" },
    "session_id": { "type": "string" },
    "run_id": { "type": "string" },
    "source": { "type": "string", "enum": ["hardware", "virtual_test", "replay"] },
    "sequence": { "type": "integer", "minimum": 0 },
    "device_monotonic_ms": { "type": "number" },
    "received_at": { "type": "string", "format": "date-time" },
    "geometry_version": { "type": "string" },
    "calibration_version": { "type": "string" },
    "baseline_version": { "type": ["string", "null"] },
    "configuration_revision": { "type": "integer" },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sensor_id", "region_id", "quantity", "unit", "quality"],
        "properties": {
          "sensor_id": { "type": "string" },
          "region_id": { "type": "string", "enum": ["FL", "FR", "MID_L", "MID_R", "RL", "RR"] },
          "quantity": { "type": "string", "enum": ["strain", "force", "acceleration", "temperature", "displacement"] },
          "value": { "type": ["number", "null"] },
          "unit": { "type": "string" },
          "quality": { "type": "string", "enum": ["valid", "uncalibrated", "stale", "invalid", "saturated"] }
        }
      }
    },
    "pose": {
      "type": ["object", "null"],
      "properties": {
        "frame_id": { "type": "string" },
        "position": {
          "type": "object",
          "required": ["x", "y", "z"],
          "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }
        },
        "orientation": {
          "type": "object",
          "required": ["x", "y", "z", "w"],
          "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" }, "w": { "type": "number" } }
        },
        "source": { "type": "string" },
        "uncertainty_m": { "type": "number" },
        "valid": { "type": "boolean" }
      }
    }
  }
}
