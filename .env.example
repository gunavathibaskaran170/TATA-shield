# SHIELD Environment Configuration
NODE_ENV=development
PORT=5173
BACKEND_HOST=localhost
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
WEBSOCKET_URL=ws://localhost:8000/ws/telemetry

# ESP32-C3 Serial Configuration
SERIAL_PORT=COM3
SERIAL_BAUD=115200

# Database Persistence
DATABASE_URL=sqlite:///./shield.db

# Unity WebSocket Server Target
UNITY_WS_HOST=localhost
UNITY_WS_PORT=8000
